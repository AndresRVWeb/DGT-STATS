# ==========================================
# DGT-STATS - Configuración de Producción
# ==========================================

# Puerto del servidor
PORT=3000
NODE_ENV=production

# URL de conexión a PostgreSQL (en tu VPS / Dokploy)
# Si usas docker-compose: postgresql://dgt_admin:dgt_secret_pass_2026@postgres:5432/dgt_stats
DATABASE_URL="postgresql://dgt_admin:dgt_secret_pass_2026@postgres:5432/dgt_stats"

# Secreto para firmar tokens JWT de autenticación de usuarios y administradores
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-seguro-en-produccion"

# Token secreto para llamadas automáticas del Cron (GitHub Actions, Dokploy Cron o crontab)
# Debe coincidir con el header 'x-api-key' enviado en POST /api/dgt/sync
API_SECRET_TOKEN="token_secreto_para_cron_sync_dgt_2026"

# Clave de Gemini AI (opcional, para generación de reportes y auditorías inteligentes)
GEMINI_API_KEY=""

# URL pública de tu SaaS (para generación de enlaces absolutos y callbacks)
APP_URL="https://dgt.andresrv.com"
